{
  "name": "fello",
  "version": "0.1.55",
  "description": "Yet another Agent client based on the ACP protocol",
  "author": {
    "name": "Zythum",
    "email": "zythum02@gmail.com"
  },
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zythum/fello.git"
  },
  "bugs": {
    "url": "https://github.com/Zythum/fello/issues"
  },
  "homepage": "https://github.com/Zythum/fello",
  "main": "out/electron/main.js",
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:server",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node20 --format=esm --outfile=out/server/main.js --packages=external --banner:js='#!/usr/bin/env node'",
    "prepare:icon:mac": "bash tools/prepare-mac-icon.sh",
    "pack:npm": "npm run build && node tools/prepare-npm-package.mjs",
    "pack:mac": "npm run prepare:icon:mac && electron-vite build && electron-builder --mac",
    "pack:win": "electron-vite build && electron-builder --win",
    "pack:linux": "electron-vite build && electron-builder --linux",
    "release:mac": "npm run prepare:icon:mac && electron-vite build && electron-builder --mac --publish always",
    "release:mac:x64": "npm run prepare:icon:mac && electron-vite build && electron-builder --mac --x64 --publish always",
    "release:mac:arm64": "npm run prepare:icon:mac && electron-vite build && electron-builder --mac --arm64 --publish always",
    "release:win": "electron-vite build && electron-builder --win --publish always",
    "release:linux": "electron-vite build && electron-builder --linux --publish always",
    "prepreview": "install-electron",
    "preview": "electron-vite preview",
    "download:grammars": "node tools/download-tree-sitter-wasm.mjs",
    "postinstall": "node tools/download-tree-sitter-wasm.mjs",
    "format": "oxfmt --write \"src/**/*.{ts,tsx}\"",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "build": {
    "appId": "com.zythum.fello",
    "productName": "Fello",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/tree-sitter-wasm",
        "to": "tree-sitter-wasm",
        "filter": [
          "*.wasm"
        ]
      }
    ],
    "mac": {
      "icon": "icons/fello.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "configs/entitlements.mac.plist",
      "entitlementsInherit": "configs/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Fello uses the microphone for realtime voice input."
      }
    },
    "win": {
      "icon": "icons/fello.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "icon": "icons/fello.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Zythum",
        "repo": "fello",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@ai-sdk/mcp": "^2.0.52",
    "@ai-sdk/openai-compatible": "^3.0.51",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@parcel/watcher": "^2.6.0",
    "ai": "^7.0.105",
    "cron": "^4.4.0",
    "cronstrue": "^3.27.0",
    "custom-electron-titlebar": "^4.4.1",
    "electron-updater": "^6.8.9",
    "es-toolkit": "^1.52.0",
    "fix-path": "^5.0.0",
    "fuse.js": "^7.5.0",
    "globby": "^16.2.4",
    "gpt-tokenizer": "^4.0.0",
    "i18next": "^26.4.2",
    "launch-editor": "^2.14.1",
    "mime-types": "^3.0.2",
    "node-pty": "^1.1.0",
    "proxy-agent": "^8.0.2",
    "qr-image": "^3.2.0",
    "ripgrep": "^0.3.1",
    "sharp": "^0.35.4",
    "undici": "^7.29.1",
    "unified-realtime-asr": "0.2.1",
    "web-tree-sitter": "^0.27.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@pierre/diffs": "^1.4.3",
    "@rexa-developer/tiks": "^0.3.0",
    "@shikijs/monaco": "^4.4.3",
    "@silurus/ooxml": "^0.87.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/json-to-pretty-yaml": "^1.2.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.13.3",
    "@types/qr-image": "^3.2.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-mentions": "^4.4.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.7.1",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "immer": "^11.1.18",
    "json-to-pretty-yaml": "^1.2.2",
    "lucide-react": "^1.46.0",
    "monaco-editor-core": "^0.56.0",
    "next-themes": "^0.4.6",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "pdfjs-dist": "^6.3.289",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "react-mentions": "^4.4.10",
    "react-resizable-panels": "^4.12.4",
    "react-router-dom": "^7.18.4",
    "react-zoom-pan-pinch": "4.2.0",
    "remark-breaks": "^4.0.0",
    "shadcn": "^4.21.0",
    "shiki": "^4.0.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-compression": "^0.5.1",
    "zustand": "^5.0.15"
  }
}
