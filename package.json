{
  "name": "fello",
  "version": "0.1.16",
  "description": "ACP Client desktop app powered by Electron",
  "author": {
    "name": "Zythum",
    "email": "zythum02@gmail.com"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "out/electron/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prepare:icon:mac": "bash tools/prepare-mac-icon.sh",
    "pack:mac": "npm run prepare:icon:mac && electron-vite build && electron-builder --mac",
    "pack:win": "electron-vite build && electron-builder --win",
    "pack:linux": "electron-vite build && electron-builder --linux",
    "release:mac": "npm run prepare:icon:mac && electron-vite build && electron-builder --mac --publish always",
    "release:mac:x64": "npm run prepare:icon:mac && electron-vite build && electron-builder --mac --x64 --publish always",
    "release:mac:arm64": "npm run prepare:icon:mac && electron-vite build && electron-builder --mac --arm64 --publish always",
    "release:win": "electron-vite build && electron-builder --win --publish always",
    "release:linux": "electron-vite build && electron-builder --linux --publish always",
    "preview": "electron-vite preview",
    "format": "oxfmt --write \"src/**/*.{ts,tsx}\"",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "build": {
    "appId": "com.zythum.fello",
    "productName": "Fello",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "icons/fello.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "icons/fello.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "icon": "icons/fello.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Zythum",
        "repo": "fello",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.0",
    "@ai-sdk/mcp": "^1.0.41",
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@ast-grep/napi": "^0.42.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@parcel/watcher": "^2.5.6",
    "@pierre/diffs": "^1.2.2",
    "@xterm/addon-web-links": "^0.12.0",
    "ai": "^6.0.176",
    "docx-preview": "^0.3.7",
    "electron-updater": "^6.8.3",
    "es-toolkit": "^1.46.1",
    "fix-path": "^5.0.0",
    "fuse.js": "^7.3.0",
    "mime-types": "^3.0.2",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^5.7.284",
    "pptx-viewer": "^0.2.2",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5",
    "xlsx-preview": "^1.0.5",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@base-ui/react": "^1.4.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.0",
    "@types/json-to-pretty-yaml": "^1.2.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-mentions": "^4.4.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "i18next": "^26.0.5",
    "json-to-pretty-yaml": "^1.2.2",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "pdf-lib": "^1.17.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.10",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.4",
    "react-mentions": "^4.4.10",
    "react-resizable-panels": "^4.10.0",
    "react-router-dom": "^7.14.1",
    "remark-breaks": "^4.0.0",
    "shadcn": "^4.3.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "zustand": "^5.0.12"
  }
}
